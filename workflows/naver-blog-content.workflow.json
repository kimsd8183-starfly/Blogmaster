{
  "id": "naver-blog-content",
  "version": "1.0.0",
  "name": "Naver Blog Content Workflow",
  "description": "네이버 블로그 콘텐츠 전략 스킬을 Master AI Workflow Builder에서 실행하기 위한 기본 파이프라인",
  "skill": "naver-blog-strategist",
  "inputs": {
    "topic": {"type": "string", "required": true},
    "audience": {"type": "string", "required": false, "default": "30~60대"},
    "content_type": {"type": "string", "required": false, "default": "여행/일상/핫이슈"},
    "fast_mode": {"type": "boolean", "required": false, "default": false}
  },
  "steps": [
    {
      "id": "keyword_strategy",
      "type": "skill",
      "skill": "naver-blog-strategist",
      "operation": "keyword_strategy",
      "input": {"topic": "{{inputs.topic}}", "audience": "{{inputs.audience}}", "content_type": "{{inputs.content_type}}"},
      "output": "keyword_plan"
    },
    {
      "id": "title_options",
      "type": "skill",
      "skill": "naver-blog-strategist",
      "operation": "title_thumbnail_hook",
      "input": {"keyword_plan": "{{steps.keyword_strategy.output}}"},
      "output": "title_plan"
    },
    {
      "id": "draft",
      "type": "skill",
      "skill": "naver-blog-strategist",
      "operation": "draft",
      "input": {"keyword_plan": "{{steps.keyword_strategy.output}}", "title_plan": "{{steps.title_options.output}}", "audience": "{{inputs.audience}}", "content_type": "{{inputs.content_type}}"},
      "output": "draft"
    },
    {
      "id": "quality_gate",
      "type": "skill",
      "skill": "naver-blog-strategist",
      "operation": "viraltest",
      "input": {"draft": "{{steps.draft.output}}"},
      "output": "quality_report"
    },
    {
      "id": "revision_gate",
      "type": "condition",
      "condition": "{{steps.quality_gate.output.total}} >= 95 || {{inputs.fast_mode}} == true",
      "then": "publish_package",
      "else": "revise"
    },
    {
      "id": "revise",
      "type": "skill",
      "skill": "naver-blog-strategist",
      "operation": "revise",
      "input": {"draft": "{{steps.draft.output}}", "quality_report": "{{steps.quality_gate.output}}"},
      "output": "revised_draft",
      "next": "quality_gate"
    },
    {
      "id": "publish_package",
      "type": "skill",
      "skill": "naver-blog-strategist",
      "operation": "publish_package",
      "input": {"draft": "{{steps.draft.output}}", "quality_report": "{{steps.quality_gate.output}}"},
      "output": "publish_package"
    }
  ],
  "outputs": {
    "content": "{{steps.publish_package.output}}",
    "quality": "{{steps.quality_gate.output}}"
  },
  "safety": {
    "no_ranking_guarantee": true,
    "no_algorithm_evasion": true,
    "require_source_for_time_sensitive_claims": true,
    "require_disclosure_for_sponsorship": true
  }
}
