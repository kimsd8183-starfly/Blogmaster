{
  "id": "naver-blog-content",
  "version": "2.0.0",
  "name": "Naver Blog Content Intelligence Workflow",
  "description": "Master AI Naver Content Intelligence Skill v2.0을 실행하는 검색의도·조사·사실검증·경험검증·품질·안전 중심 파이프라인",
  "skill": "naver-blog-strategist",
  "inputs": {
    "topic": {"type": "string", "required": true},
    "audience": {"type": "string", "required": false, "default": "30~60대"},
    "content_type": {"type": "string", "required": false, "default": "여행"},
    "experience_data": {"type": "string", "required": false, "default": ""},
    "fast_mode": {"type": "boolean", "required": false, "default": false}
  },
  "steps": [
    {
      "id": "keyword_strategy",
      "type": "skill",
      "skill": "naver-blog-strategist",
      "operation": "keyword_strategy",
      "input": {"topic": "{{inputs.topic}}", "audience": "{{inputs.audience}}", "contentType": "{{inputs.content_type}}"},
      "output": "keyword_plan"
    },
    {
      "id": "research",
      "type": "skill",
      "skill": "naver-blog-strategist",
      "operation": "research",
      "input": {"topic": "{{inputs.topic}}", "searchIntent": "{{steps.keyword_strategy.output.searchIntent}}", "keywords": "{{steps.keyword_strategy.output.relatedKeywords}}"},
      "output": "research"
    },
    {
      "id": "title_options",
      "type": "skill",
      "skill": "naver-blog-strategist",
      "operation": "title_thumbnail_hook",
      "input": {"keyword_plan": "{{steps.keyword_strategy.output}}"},
      "output": "title_plan"
    },
    {
      "id": "draft",
      "type": "skill",
      "skill": "naver-blog-strategist",
      "operation": "draft",
      "input": {"keyword_plan": "{{steps.keyword_strategy.output}}", "research": "{{steps.research.output}}", "title_plan": "{{steps.title_options.output}}", "audience": "{{inputs.audience}}", "contentType": "{{inputs.content_type}}", "experienceData": "{{inputs.experience_data}}"},
      "output": "draft"
    },
    {
      "id": "experience_check",
      "type": "skill",
      "skill": "naver-blog-strategist",
      "operation": "experience_check",
      "input": {"draft": "{{steps.draft.output}}", "experienceData": "{{inputs.experience_data}}"},
      "output": "experience_report"
    },
    {
      "id": "quality_gate",
      "type": "skill",
      "skill": "naver-blog-strategist",
      "operation": "quality_gate",
      "input": {"draft": "{{steps.draft.output}}", "research": "{{steps.research.output}}", "experience_check": "{{steps.experience_check.output}}"},
      "output": "quality_report"
    },
    {
      "id": "safety_guard",
      "type": "skill",
      "skill": "naver-blog-strategist",
      "operation": "safety_guard",
      "input": {"draft": "{{steps.draft.output}}", "quality_report": "{{steps.quality_gate.output}}"},
      "output": "safety_report"
    },
    {
      "id": "revision_gate",
      "type": "condition",
      "condition": "{{steps.quality_gate.output.total}} >= 90 && {{steps.safety_guard.output.overallRisk}} == 'low' || {{inputs.fast_mode}} == true",
      "then": "publish_package",
      "else": "revise"
    },
    {
      "id": "revise",
      "type": "skill",
      "skill": "naver-blog-strategist",
      "operation": "revise",
      "input": {"draft": "{{steps.draft.output}}", "quality_report": "{{steps.quality_gate.output}}", "safety_report": "{{steps.safety_guard.output}}"},
      "output": "revised_draft",
      "next": "quality_gate"
    },
    {
      "id": "publish_package",
      "type": "skill",
      "skill": "naver-blog-strategist",
      "operation": "publish_package",
      "input": {"draft": "{{steps.draft.output}}", "quality_report": "{{steps.quality_gate.output}}", "safety_report": "{{steps.safety_guard.output}}"},
      "output": "publish_package"
    }
  ],
  "outputs": {
    "content": "{{steps.publish_package.output}}",
    "quality": "{{steps.quality_gate.output}}",
    "safety": "{{steps.safety_guard.output}}"
  },
  "safety": {
    "no_ranking_guarantee": true,
    "no_algorithm_evasion": true,
    "require_source_for_time_sensitive_claims": true,
    "require_experience_verification": true,
    "require_disclosure_for_sponsorship": true,
    "privacy_guard": true,
    "keyword_stuffing_guard": true
  }
}
